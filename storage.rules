rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function superadmin() {
      return signedIn() && request.auth.token.role == 'superadmin';
    }

    // Path strategy: tenants/{tenantId}/...
    match /tenants/{tenantId}/{allPaths=**} {
      // Solo miembros del mismo tenant (o superadmin) pueden leer. Sin este
      // filtro, cualquier usuario autenticado de OTRO conjunto leeria estos
      // archivos (actas, reglamento, documentos) — fuga cross-tenant.
      allow read: if signedIn() && (
        superadmin() || request.auth.token.tenantId == tenantId
      );

      // Admin and superadmin can upload tenant documents. Límite de 25 MB por
      // archivo (gobernanza de costo/abuso). En delete request.resource es null.
      allow write: if signedIn() && (
        superadmin() || request.auth.token.tenantId == tenantId
      ) && (
        request.resource == null || request.resource.size < 25 * 1024 * 1024
      );
    }

    // Block everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
