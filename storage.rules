rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function superadmin() {
      return signedIn() && request.auth.token.role == 'superadmin';
    }

    // Path strategy: tenants/{tenantId}/...
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if signedIn();

      // Admin and superadmin can upload tenant documents.
      allow write: if signedIn() && (
        superadmin() || request.auth.token.tenantId == tenantId
      );
    }

    // Block everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
