rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function rol() {
      return request.auth.token.role;
    }

    // Los tres roles con peso aquí llevan un alias antiguo todavía vivo en
    // tokens emitidos: `super_admin`, `admin_tenant` y `security`. Mirar solo
    // el nombre nuevo dejaría a un administrador antiguo fuera de sus propios
    // documentos financieros. Mismo criterio que firestore.rules.
    function superadmin() {
      return signedIn() && rol() in ['superadmin', 'super_admin'];
    }

    // ── Por qué esto mira el CLAIM y no la membresía ────────────────────────
    //
    // Se intentó lo contrario el 25 de agosto de 2026 —`firestore.exists` sobre
    // `tenantUsers`, para que Storage y Firestore resolvieran igual— y **hubo
    // que revertirlo: rompe TODAS las subidas en el servicio real**. Se midió:
    // con esta versión, subir un documento en staging funciona; con la de
    // reglas entre servicios, no sube nada, y falla también en el conjunto
    // donde el claim y el activo coinciden.
    //
    // **Y las 59 pruebas de esta suite pasaban, falsadas en dos direcciones.**
    // Corren contra el emulador, y el emulador **no es el servicio**: es el
    // único mecanismo de este repositorio que las pruebas no pueden cubrir.
    // Antes de volver a intentarlo, subir un archivo de verdad.
    //
    // La consecuencia hay que saberla: con el selector de conjunto de
    // `PLAT-002`, el claim tiene que **seguir** al conjunto activo, y por eso
    // cambiar de conjunto lo re-emite (`switchActiveTenant`). El precio de esa
    // decisión es que **dos pestañas en conjuntos distintos se pisan**, porque
    // el claim es uno por usuario.
    function delConjunto(tenantId) {
      return signedIn() && request.auth.token.tenantId == tenantId;
    }

    // Cualquiera con acceso al conjunto, sea cual sea su rol.
    function miembro(tenantId) {
      return superadmin() || delConjunto(tenantId);
    }

    function admin(tenantId) {
      return superadmin() || (delConjunto(tenantId) && rol() in ['tenant_admin', 'admin_tenant']);
    }

    function porteria(tenantId) {
      return delConjunto(tenantId) && rol() in ['security_guard', 'security'];
    }

    // Límite de 25 MB por archivo (gobernanza de costo/abuso). En delete
    // request.resource es null.
    function tamanoOk() {
      return request.resource == null || request.resource.size < 25 * 1024 * 1024;
    }

    // ── Por qué no hay una regla ancha sobre tenants/{id}/** ────────────────
    //
    // Las reglas de Storage SUMAN permisos: no existe la regla que quita. Una
    // concesión ancha sobre todo el árbol del conjunto no se puede recortar
    // después por subcarpeta — cualquier regla de abajo solo añade. Por eso el
    // permiso se concede carpeta a carpeta y lo que no se nombra queda negado.
    //
    // Consecuencia práctica: una carpeta nueva no funciona hasta que aparezca
    // en una de estas listas. Es deliberado — es lo contrario de lo que pasaba
    // antes, cuando una carpeta nueva nacía abierta a todo el conjunto.

    // Dinero y gobierno del conjunto: cierres de facturación, histórico de
    // cartera, libro contable y reportes de comité. Solo administración.
    function carpetasFinancieras() {
      return ['billing-closures', 'cartera-history', 'ledger-history', 'committee-reports'];
    }

    // Documentación del conjunto: la publica la administración y la consulta
    // todo el mundo (reglamento, actas, comunicados, servicios, logo, acuerdos).
    function carpetasCompartidas() {
      return ['documents', 'communications', 'services', 'branding', 'amenity-photos', 'agreements'];
    }

    match /tenants/{tenantId}/{carpeta}/{resto=**} {
      allow read: if
        (carpeta in carpetasFinancieras() && admin(tenantId)) ||
        (carpeta in carpetasCompartidas() && miembro(tenantId));

      allow write: if
        (carpeta in carpetasFinancieras() || carpeta in carpetasCompartidas()) &&
        admin(tenantId) && tamanoOk();
    }

    // ── Carpetas con dueño ──────────────────────────────────────────────────

    // Comprobantes de pago. El residente sube el suyo y lo lee —necesita la
    // lectura porque el código pide la URL de descarga justo después de subir—,
    // pero no ve el de sus vecinos. La administración los lee todos para
    // revisarlos. Los comprobantes anteriores a este cambio viven bajo el
    // identificador de UNIDAD en vez del de usuario: quedan solo para admin,
    // que es quien los revisa, y nada del producto los busca por ruta.
    match /tenants/{tenantId}/payment-receipts/{duenoUid}/{resto=**} {
      allow read: if admin(tenantId) ||
        (miembro(tenantId) && duenoUid == request.auth.uid);

      allow write: if (admin(tenantId) ||
        (miembro(tenantId) && duenoUid == request.auth.uid)) && tamanoOk();
    }

    // Notas de visitantes: las escribe portería desde el puesto de vigilancia.
    match /tenants/{tenantId}/visitor-notes/{resto=**} {
      allow read: if admin(tenantId) || porteria(tenantId);
      allow write: if (admin(tenantId) || porteria(tenantId)) && tamanoOk();
    }

    // Evidencia de tickets de soporte, segmentada por quien la sube. El que
    // adjunta lee lo suyo —getDownloadURL tras subir pasa por `allow read`— y
    // la administración lo lee todo: es quien abre y responde los tickets del
    // conjunto, y un hilo puede llevar adjuntos de más de una persona. La
    // evidencia anterior a este cambio vive plana (`support/{archivo}`): el
    // nombre del archivo cae en el hueco del dueño y no es el uid de nadie,
    // así que queda solo para administración — mismo criterio que los
    // comprobantes viejos por unidad.
    match /tenants/{tenantId}/support/{duenoUid}/{resto=**} {
      allow read: if admin(tenantId) ||
        (miembro(tenantId) && duenoUid == request.auth.uid);

      allow write: if (admin(tenantId) ||
        (miembro(tenantId) && duenoUid == request.auth.uid)) && tamanoOk();
    }

    // Todo lo demás, negado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
