# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firestore-debug.log*
firebase-debug.log*
ui-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla SÍ se versiona: es lo que evita que alguien arranque sin
# configurar y acabe en el proyecto equivocado.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Salida de Playwright
test-results/

# Salida de los guiones de medicion del landing
.simulacion-perspectivas/
.verificacion-perspectivas/

# Corridas simuladas de la evaluación: son desechables. Las reales SÍ se versionan:
# son la evidencia de la puerta G4.
datasets/evaluacion/resultados/*-simulado.json
