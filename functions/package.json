{
  "name": "hogaru-functions",
  "private": true,
  "version": "1.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "backfill:names": "node scripts/backfill-readable-names.mjs",
    "backfill:names:write": "node scripts/backfill-readable-names.mjs --write",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run",
    "test:emulator": "vitest run --config vitest.emulator.config.mts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.1.1",
    "pdfkit": "^0.15.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
