{
  "name": "hogaru-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "backfill:names": "node scripts/backfill-readable-names.mjs",
