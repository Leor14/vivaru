rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function superadmin() {
      return signedIn() && request.auth.token.role == 'superadmin';
    }

    function membershipDoc(tenantId) {
      return get(/databases/$(database)/documents/tenantUsers/$(tenantId + '_' + request.auth.uid));
    }

    function tenantMember(tenantId) {
      return signedIn() && exists(/databases/$(database)/documents/tenantUsers/$(tenantId + '_' + request.auth.uid));
    }

    function tenantRole(tenantId, role) {
      return tenantMember(tenantId) && (
        membershipDoc(tenantId).data.role == role ||
        (role == 'tenant_admin' && membershipDoc(tenantId).data.role == 'admin_tenant')
      );
    }

    function residentOwnUnit(tenantId, unitId) {
      return tenantRole(tenantId, 'resident') && membershipDoc(tenantId).data.unitId == unitId;
    }

    function securityGuardRole(tenantId) {
      return tenantRole(tenantId, 'security_guard') || tenantRole(tenantId, 'security');
    }

    function tenantAdminOrSuper(tenantId) {
      return superadmin() || tenantRole(tenantId, 'tenant_admin');
    }

    function sameTenant(tenantId) {
      return superadmin() || tenantMember(tenantId);
    }

    // Estados que permiten ESCRITURA. 'suspended' (cliente que dejó de pagar) y
    // 'expired' (prueba vencida) quedan en solo lectura: conservan sus datos y
    // pueden consultarlos, pero no operar. La LECTURA nunca pasa por aquí.
    // Un tenant sin `status` se asume operable (datos previos a este campo).
    // Espejo de assertTenantOperable() en functions/src/index.ts.
    function tenantOperable(tenantId) {
      return superadmin() ||
        !exists(/databases/$(database)/documents/tenants/$(tenantId)) ||
        !('status' in get(/databases/$(database)/documents/tenants/$(tenantId)).data) ||
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.status in ['active', 'trial'];
    }

    // Módulos en VISTA PREVIA durante la prueba (Regla A del plan self-service):
    // Cartera, Egresos/Libro/Conciliación, Reporte de Comité y firmas del
    // Reglamento se VEN con datos de ejemplo pero no se operan hasta contratar.
    // Un cliente (`active`) nunca se bloquea. Espejo de assertModuleAllowed()
    // en functions/src/trial-modules.ts.
    function previewModuleWritable(tenantId) {
      return superadmin() ||
        !exists(/databases/$(database)/documents/tenants/$(tenantId)) ||
        !('status' in get(/databases/$(database)/documents/tenants/$(tenantId)).data) ||
        !(get(/databases/$(database)/documents/tenants/$(tenantId)).data.status in ['trial', 'expired']);
    }

    function amenityDoc(amenityId) {
      return get(/databases/$(database)/documents/amenities/$(amenityId));
    }

    function amenityReservableForTenant(tenantId, amenityId) {
      return amenityId is string &&
        exists(/databases/$(database)/documents/amenities/$(amenityId)) &&
        amenityDoc(amenityId).data.tenantId == tenantId &&
        amenityDoc(amenityId).data.status == 'active' &&
        (!('isReservable' in amenityDoc(amenityId).data) || amenityDoc(amenityId).data.isReservable == true) &&
        (!('deletedAt' in amenityDoc(amenityId).data) || amenityDoc(amenityId).data.deletedAt == null);
    }

    function relaxedTenantCollection(collection) {
      return collection in ['communications'];
    }

    // ─── `PRD-V-PLAT-006` · la puerta de ENTRADA ───────────────────────────
    //
    // En un conjunto marcado `sinClienteDetras` solo se admiten direcciones de
    // prueba o del equipo. Espejo de `functions/src/buzones-admisibles.ts`, y
    // hace falta **además** de aquél porque las dos palancas protegen caminos
    // distintos: `people` lo escribe el CLIENTE (el formulario y la importación
    // masiva, que va por `writeBatch` desde el navegador), mientras `users` y
    // `tenantUsers` solo los escriben callables — y una callable va con Admin
    // SDK, que NO evalúa estas reglas. Es la lección de `CF8`.
    //
    // **Coste:** cero lecturas extra en un conjunto SIN marcar, que son todos
    // los que tienen cliente. `tenants/{id}` ya lo lee `tenantOperable`, y
    // Firestore cuenta una sola vez la misma ruta dentro de una evaluación; el
    // resto solo se consulta si la marca está puesta.
    function conjuntoSinClienteDetras(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('sinClienteDetras', false) == true;
    }

    // Resuelve `producto-puerta-de-buzones` con la MISMA precedencia que
    // `resolveFeatureFlag` en el servidor: kill switch maestro, kill switch de
    // la bandera, override del conjunto, valor global.
    //
    // **El default es `false` y aquí va escrito a mano**, porque una regla no
    // puede leer el catálogo del código. Si alguien cambia `defaultEnabled` a
    // `true` en `src/lib/feature-flags/catalog.ts`, esta regla se queda atrás y
    // la puerta de entrada dejaría de aplicarse sin que nada falle. Lo vigila
    // `tests/puerta-de-buzones.rules.test.ts`.
    function flagDataPuerta() {
      return exists(/databases/$(database)/documents/featureFlags/producto-puerta-de-buzones)
        ? get(/databases/$(database)/documents/featureFlags/producto-puerta-de-buzones).data
        : {};
    }

    function killSwitchMaestroPuesto() {
      return exists(/databases/$(database)/documents/featureFlags/_global)
        && get(/databases/$(database)/documents/featureFlags/_global).data.get('killSwitch', false) == true;
    }

    function overridePuerta(tenantId) {
      return exists(/databases/$(database)/documents/featureFlagOverrides/$(tenantId))
        ? get(/databases/$(database)/documents/featureFlagOverrides/$(tenantId)).data.get('flags', {})
        : {};
    }

    function puertaDeBuzonesActiva(tenantId) {
      return !killSwitchMaestroPuesto()
        && flagDataPuerta().get('killSwitch', false) != true
        && (
          overridePuerta(tenantId).get('producto-puerta-de-buzones', null) is bool
            ? overridePuerta(tenantId).get('producto-puerta-de-buzones', false) == true
            : flagDataPuerta().get('enabled', false) == true
        );
    }

    // El dominio, en minúsculas. Devuelve '' si no hay un `@` con algo detrás,
    // y '' no está en ninguna lista, así que una dirección malformada se rechaza.
    function dominioDeCorreo(email) {
      return email is string && email.matches('.+@.+') ? email.lower().split('@')[1] : '';
    }

    // **Igualdad exacta, sin subdominios.** El servidor admite además los
    // subdominios (`x.ejemplo.vivaru.app`); aquí no, y la diferencia es
    // deliberada: la ENTRADA más estricta que la SALIDA es segura —nada entra
    // que la salida fuese a rechazar—, y al revés no lo sería.
    function dominioInerte(dominio) {
      return dominio in ['ejemplo.vivaru.app', 'demo.grupovivaru.com', 'hogaru.test', 'demo.co', 'example.com'];
    }

    function correoDelEquipo(email) {
      return exists(/databases/$(database)/documents/config/correosDelEquipo) && (
        dominioDeCorreo(email) in get(/databases/$(database)/documents/config/correosDelEquipo).data.get('dominios', [])
        || email.lower() in get(/databases/$(database)/documents/config/correosDelEquipo).data.get('direcciones', [])
      );
    }

    // `RN-2`. **No se normaliza el `+alias`**: `david+res1@…` se admite solo si
    // está listada tal cual o si su dominio entero lo está. Quitar el alias
    // convertiría una dirección listada en una familia infinita.
    function buzonAdmisible(email) {
      return dominioInerte(dominioDeCorreo(email)) || correoDelEquipo(email);
    }

    // La puerta, con sus tres cortocircuitos en orden de coste creciente.
    function puertaDeBuzonesPermite(tenantId, email) {
      return !(email is string) || email == ''
        || !conjuntoSinClienteDetras(tenantId)
        || !puertaDeBuzonesActiva(tenantId)
        || buzonAdmisible(email);
    }

    // `PRD-V-FLOW-003` R5 y R6 — el calendario de cobranza, validado DONDE NO SE SALTA.
    //
    // §11.2 lo dice y conviene repetirlo: si el rango solo se comprueba en el
    // formulario, se salta con una escritura directa desde la consola. Y R6 no es
    // cosmético — un ciclo de un día es un correo diario a alguien que debe dinero.
    //
    // **Tolera que el calendario NO venga**, y eso no es laxitud: `updateDoc` fusiona
    // y la regla evalúa el documento RESULTANTE, así que una escritura parcial que
    // toque otro campo llega aquí sin `billingCalendar` y no debe rechazarse.
    function calendarioDeCobranzaValido(d) {
      return !('billingCalendar' in d) || (
        (
          !('noticeDayOfMonth' in d.billingCalendar)
          || d.billingCalendar.noticeDayOfMonth == null
          || (d.billingCalendar.noticeDayOfMonth is int
              && d.billingCalendar.noticeDayOfMonth >= 1
              && d.billingCalendar.noticeDayOfMonth <= 28)
        ) && (
          !('overdueCycleDays' in d.billingCalendar)
          || d.billingCalendar.overdueCycleDays == null
          || (d.billingCalendar.overdueCycleDays is int
              && d.billingCalendar.overdueCycleDays >= 7)
        )
      );
    }

    function pad2(value) {
      return value < 10 ? ('0' + value) : ('' + value);
    }

    function timestampDateKey(value) {
      return '' + value.year() + '-' + pad2(value.month()) + '-' + pad2(value.day());
    }

    function timestampTimeKey(value) {
      return pad2(value.hours()) + ':' + pad2(value.minutes());
    }

    function isValidDateText(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeText(value) {
      return value is string && value.matches('^[0-9]{2}:[0-9]{2}$');
    }

    function isDateTimeAtOrAfterBuffer(dateText, timeText, bufferMinutes) {
      let minimum = request.time + duration.value(bufferMinutes, 'm');
      let minimumDate = timestampDateKey(minimum);
      let minimumTime = timestampTimeKey(minimum);
      return isValidDateText(dateText) &&
        isValidTimeText(timeText) &&
        (dateText > minimumDate || (dateText == minimumDate && timeText >= minimumTime));
    }

    function isValidInvitationWindow(startAt, endAt) {
      return startAt is timestamp &&
        endAt is timestamp &&
        startAt >= (request.time + duration.value(15, 'm')) &&
        endAt > startAt;
    }

    match /tenants/{tenantId} {
      allow read: if sameTenant(tenantId);
      allow create, update, delete: if superadmin();
    }

    match /tenantUsers/{tenantUserId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        superadmin() ||
        tenantRole(resource.data.tenantId, 'tenant_admin')
      );

      allow create, delete: if superadmin();

      // Tenant admin can update only their own membership display fields.
      allow update: if superadmin() || (
        signedIn() &&
        resource.data.uid == request.auth.uid &&
        tenantRole(resource.data.tenantId, 'tenant_admin') &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.unitId == resource.data.unitId &&
        request.resource.data.unitLabel == resource.data.unitLabel
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        uid == request.auth.uid ||
        superadmin() ||
        (resource.data.tenantId is string && tenantRole(resource.data.tenantId, 'tenant_admin'))
      );

      // Allow users to update only their own profile while keeping identity and role immutable.
      allow update: if signedIn() && uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.tenantId == resource.data.tenantId &&
        (!('mustChangePassword' in resource.data) || request.resource.data.mustChangePassword == resource.data.mustChangePassword) &&
        (!('temporaryPassword' in resource.data) || request.resource.data.temporaryPassword == resource.data.temporaryPassword) &&
        (!('passwordStatus' in resource.data) || request.resource.data.passwordStatus == resource.data.passwordStatus) &&
        (!('temporaryPasswordUpdatedAt' in resource.data) || request.resource.data.temporaryPasswordUpdatedAt == resource.data.temporaryPasswordUpdatedAt) &&
        (!('passwordChangedAt' in resource.data) || request.resource.data.passwordChangedAt == resource.data.passwordChangedAt) &&
        // `PRD-V-FEAT-007`. El tema es preferencia de presentacion del propio
        // usuario, asi que se escribe directo — no hay callable que valga aqui.
        // Esta linea NO cierra ningun agujero: la regla de arriba no lista los
        // campos permitidos, asi que el dueño ya podia escribir lo que quisiera
        // en su documento, y eso es ANTERIOR a esta ficha. Lo que hace es que el
        // dato no se ensucie. Solo condiciona `tema` y solo si esta presente:
        // una edicion de perfil corriente no la toca.
        (!('tema' in request.resource.data) ||
          request.resource.data.tema in ['claro', 'oscuro']);

      allow create, delete: if false;
    }

    // Credenciales de entrega de Web Push (PRD-V-PLAT-005). El id del documento
    // ES el token FCM — idempotencia natural: re-registrar sobrescribe, no
    // duplica. Solo el dueño las ve; el envío las lee con Admin SDK, que no
    // pasa por aquí. Escribir (create o update) exige reclamar el documento
    // como propio: re-registrar el mismo dispositivo es un update, y en un
    // teléfono prestado reescribe el userId (R4) — poseer el token, que es
    // inadivinable, es la prueba de poseer el dispositivo. Registrar es
    // lectura de avisos, no operación del conjunto, así que NO pasa por
    // tenantOperable: un suspendido puede seguir leyendo.
    match /pushTokens/{token} {
      allow read, delete: if signedIn() && (
        superadmin() ||
        resource.data.userId == request.auth.uid
      );

      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.tenantId is string &&
        tenantMember(request.resource.data.tenantId);
    }

    match /notifications/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid && (
        superadmin() ||
        (
          resource.data.tenantId is string &&
          sameTenant(resource.data.tenantId)
        ) ||
        (!('tenantId' in resource.data) || resource.data.tenantId == null)
      );

      allow create: if signedIn() && request.resource.data.userId is string && request.resource.data.userId == request.auth.uid && (
        superadmin() ||
        (
          request.resource.data.tenantId is string &&
          sameTenant(request.resource.data.tenantId)
        )
      );

      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.link == resource.data.link;

      allow delete: if signedIn() && (
        superadmin() ||
        (
          resource.data.tenantId is string &&
          tenantRole(resource.data.tenantId, 'tenant_admin')
        )
      );
    }

    match /units/{docId} {
      allow read: if signedIn() && sameTenant(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    match /people/{docId} {
      allow read: if signedIn() && sameTenant(resource.data.tenantId);

      // `PLAT-006`: al CREAR se mira siempre el correo. Este es el camino de la
      // importación masiva, que escribe `people` con `writeBatch` desde el
      // navegador — y un padrón importado es la forma más rápida de meter mil
      // direcciones de desconocidos en un conjunto de demostración.
      allow create: if tenantOperable(request.resource.data.tenantId)
        && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId))
        && puertaDeBuzonesPermite(request.resource.data.tenantId, request.resource.data.get('email', ''));

      // Al ACTUALIZAR, solo si el correo CAMBIA. `updateDoc` fusiona y la regla
      // evalúa el documento RESULTANTE, así que mirar el correo siempre
      // bloquearía cambiarle el teléfono a cualquiera de las once direcciones
      // que ya están dentro — a las que esta ficha protege por la SALIDA, no
      // echándolas. Misma trampa que `calendarioDeCobranzaValido`.
      allow update: if tenantOperable(request.resource.data.tenantId)
        && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId))
        && (
          request.resource.data.get('email', '') == resource.data.get('email', '')
          || puertaDeBuzonesPermite(request.resource.data.tenantId, request.resource.data.get('email', ''))
        );

      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    // Credenciales de las cuentas de prueba del trial. Contienen contraseñas en
    // claro, así que NO pueden vivir en tenantSettings (que lee cualquier
    // miembro del tenant): solo el admin del conjunto y el superadmin.
    // `PRD-V-PLAT-006` D2 · configuración de plataforma, del superadmin y de nadie más.
    //
    // **Existe porque el control de su propia prueba falló.** `config` no está en
    // `relaxedTenantCollection`, así que la regla comodín de abajo la negaba a
    // TODOS — y el `tenant_admin` no podía leerla, que era lo que `CA8` pedía,
    // pero **el superadmin tampoco**, y §3 le encarga mantener la lista. Sin la
    // prueba de control, los `assertFails` de `CA8` habrían pasado por la razón
    // equivocada y la lista solo habría sido editable por script.
    //
    // No lleva `tenantId` a propósito: la lista del equipo es GLOBAL, porque el
    // equipo es el mismo en los nueve conjuntos.
    match /config/{docId} {
      allow read, write: if signedIn() && superadmin();
    }

    match /tenantDemoAccounts/{tenantId} {
      allow read: if signedIn() && tenantAdminOrSuper(tenantId);
      allow write: if false;  // solo el Admin SDK al provisionar
    }

    // Progreso del recorrido guiado. Colección propia y NO un campo de
    // `tenants`: ese documento guarda `status` y `trialEndsAt`, y darle
    // escritura al admin para palomear un checklist le abriría la puerta a
    // extenderse la prueba solo. Aquí lo peor que puede hacer es mentirse a sí
    // mismo sobre su propio avance.
    match /tenantOnboarding/{tenantId} {
      allow read: if signedIn() && tenantAdminOrSuper(tenantId);
      allow create, update: if signedIn() && tenantAdminOrSuper(tenantId)
        && request.resource.data.tenantId == tenantId;
      allow delete: if signedIn() && superadmin();
    }

    match /tenantSettings/{tenantId} {
      allow read: if signedIn() && sameTenant(tenantId);
      allow create, update: if tenantOperable(tenantId) && (signedIn() && tenantAdminOrSuper(tenantId) && request.resource.data.tenantId == tenantId)
        && calendarioDeCobranzaValido(request.resource.data);
      allow delete: if tenantOperable(tenantId) && (signedIn() && superadmin());
    }

    // Shared tenant-scoped collections.
    match /{collection}/{docId} {
      allow read: if signedIn() && relaxedTenantCollection(collection) && resource.data.tenantId is string && sameTenant(resource.data.tenantId);

      // Strict write policy: tenant admins manage operational collections, residents limited per collection below.
      allow create, update: if signedIn() && relaxedTenantCollection(collection) && request.resource.data.tenantId is string && tenantOperable(request.resource.data.tenantId) && (
        superadmin() || tenantRole(request.resource.data.tenantId, 'tenant_admin')
      );

      // Delete must validate against existing resource because request.resource is null on deletes.
      allow delete: if signedIn() && relaxedTenantCollection(collection) && resource.data.tenantId is string && tenantOperable(resource.data.tenantId) && (
        superadmin() || tenantRole(resource.data.tenantId, 'tenant_admin')
      );
    }

    // Resident writes for own records.
    match /visitorInvitations/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      allow create: if tenantOperable(request.resource.data.tenantId) && (signedIn() && (
        tenantAdminOrSuper(request.resource.data.tenantId) ||
        (
          residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
          request.resource.data.residentUserId == request.auth.uid
        )
      ) && isValidInvitationWindow(request.resource.data.startAt, request.resource.data.endAt));
      allow update, delete: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          residentOwnUnit(resource.data.tenantId, resource.data.unitId) &&
          resource.data.residentUserId == request.auth.uid &&
          request.resource.data.unitId == resource.data.unitId
        )
      ) && (
        request.resource == null ||
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['startAt', 'endAt']) ||
        isValidInvitationWindow(request.resource.data.startAt, request.resource.data.endAt)
      ));
    }

    match /visitorPasses/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        securityGuardRole(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      allow create: if tenantOperable(request.resource.data.tenantId) && (signedIn() && (
        tenantAdminOrSuper(request.resource.data.tenantId) ||
        (
          residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
          request.resource.data.createdBy == request.auth.uid
        )
      ));
      allow update: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          residentOwnUnit(resource.data.tenantId, resource.data.unitId) &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.unitId == resource.data.unitId
        ) ||
        (
          securityGuardRole(resource.data.tenantId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "checkInAt", "checkOutAt"]) &&
          (
            (
              resource.data.status == "scheduled" &&
              request.resource.data.status == "inside" &&
              request.resource.data.checkInAt != null &&
              request.resource.data.checkOutAt == resource.data.checkOutAt &&
              // `PRD-V-FLOW-005` R1 y CF4 — **a `inside` solo se llega desde `autorizada`.**
              //
              // El registro de ingreso es escritura DIRECTA del guardia, no una callable, asi que
              // sin esta linea un pase capturado en porteria podria entrar estando `pendiente`
              // —o `rechazada`— y la autorizacion seria decorativa.
              //
              // **La ausencia del campo significa «es del flujo de QR»**, y esos entran como
              // siempre: los 142 pases de los dos ambientes no lo tienen, asi que esta condicion
              // NO restringe nada de lo que ya existe. Por eso las reglas pueden ir primero.
              (
                !("authorizationStatus" in resource.data) ||
                resource.data.authorizationStatus == "autorizada"
              )
            ) ||
            (
              resource.data.status == "inside" &&
              request.resource.data.status == "completed" &&
              request.resource.data.checkInAt == resource.data.checkInAt &&
              request.resource.data.checkOutAt != null
            )
          )
        ) ||
        (
          securityGuardRole(resource.data.tenantId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardNotes'])
        )
      ));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          residentOwnUnit(resource.data.tenantId, resource.data.unitId) &&
          resource.data.createdBy == request.auth.uid &&
          request.resource == null
        )
      ));
    }

    match /visitorAuthorizations/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );

      // El buffer de 15 min (comparación de wall-clock) no es zona-horaria-segura;
      // el cliente ya lo valida en hora local. Para el admin (confiable) no se
      // aplica en la regla para no rechazar visitas válidas del mismo día.
      allow create: if tenantOperable(request.resource.data.tenantId) && (signedIn() && (
        tenantAdminOrSuper(request.resource.data.tenantId) ||
        (
          residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
          request.resource.data.createdBy == request.auth.uid &&
          isDateTimeAtOrAfterBuffer(request.resource.data.startDate, request.resource.data.startTime, 15)
        )
      ));

      allow update, delete: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          residentOwnUnit(resource.data.tenantId, resource.data.unitId) &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.unitId == resource.data.unitId
        )
      ) && (
        request.resource == null ||
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['startDate', 'startTime']) ||
        isDateTimeAtOrAfterBuffer(request.resource.data.startDate, request.resource.data.startTime, 15)
      ));
    }

    // `advanceAppliedAmount` (FLOW-002 R4) lo escribe SOLO el servidor, y esta es
    // la unica cosa que lo protege.
    //
    // No es una coleccion nueva: es un CAMPO dentro de un documento que el
    // cliente sigue editando. `actualizarBillingStatement`
    // (src/features/billing/use-billing-statements.ts) hace un `updateDoc`
    // directo desde el navegador con `paymentAmount` y `balance` tal cual se los
    // da el cajon de edicion. Si lo cruzado con anticipo viviera en
    // `paymentAmount`, una edicion a mano lo borraria o lo duplicaria **sin que
    // ningun `advanceApplication` se enterase**, y el saldo a favor de un
    // residente cambiaria sin rastro.
    //
    // Por eso vive en su propio campo y por eso el campo se veta aqui: en
    // `create` no puede nacer con valor, y en `update` tiene que salir igual que
    // entro. El `.get(...,0)` cubre los documentos anteriores a FLOW-002, que no
    // lo tienen — sin el, toda edicion de un cargo viejo quedaria denegada.
    match /billingStatements/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      // `create` y `update` van JUNTAS, como estaban. Separarlas parecia mas
      // legible y costo una hora: cada `setDoc` evalua las dos ramas, y
      // `tenantOperable` + `tenantAdminOrSuper` + `previewModuleWritable` hacen
      // varios `get()` cada una. Al duplicarse se pasa el limite de accesos a
      // documentos por peticion, y la regla devuelve **error de evaluacion**.
      // Denegaba igual, asi que las pruebas pasaban EN VERDE por el motivo
      // equivocado — solo se vio leyendo el log del emulador.
      //
      // El guardian va dentro: en `create` (`resource == null`) el campo tiene
      // que valer cero o no estar; en `update` tiene que salir igual que entro.
      //
      // **`FLOW-001` añade tres guardianes más, con la MISMA forma y por la
      // misma razón: son accesos al MAPA de la petición, no a la base.**
      // Comprobar «¿este `campaignId` es de un reparto?» habría exigido leer la
      // corrida —otro `get()`— y es exactamente lo que el párrafo de arriba dice
      // que no cabe. Por eso el guardián mira campos del propio documento.
      //
      //  1. **`sourceExpenseId` no lo pone el cliente.** Sin esto, cualquier
      //     administrador fabrica a mano un cargo con el sello de una corrida
      //     que nunca existió: aparecería colgando de una factura real, con su
      //     importe, y la trazabilidad de §4.6 mentiría en los dos sentidos.
      //
      //  2. **La anulación no se falsifica desde el cliente.** `status:
      //     'cancelled'`, `cancelledBy` y `cancellationReason` los escribe
      //     `cancelDistribution`, que es quien comprueba R7 —ningún cargo con
      //     pagos— y exige el motivo de R8. Un `updateDoc` directo se saltaría
      //     las dos: dejaría un cargo «anulado» sobre dinero ya cobrado, y con
      //     el autor que quisiera. **Es la lección de `CF8` al revés**: allí la
      //     callable escribía lo que la regla vetaba; aquí la regla veta lo que
      //     solo la callable debe escribir.
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId))
        && request.resource.data.get('advanceAppliedAmount', 0) == (resource == null ? 0 : resource.data.get('advanceAppliedAmount', 0))
        && request.resource.data.get('sourceExpenseId', '') == (resource == null ? '' : resource.data.get('sourceExpenseId', ''))
        && request.resource.data.get('status', '') != 'cancelled'
        && request.resource.data.get('cancelledBy', '') == (resource == null ? '' : resource.data.get('cancelledBy', ''))
        && request.resource.data.get('cancellationReason', '') == (resource == null ? '' : resource.data.get('cancellationReason', ''));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId));
    }

    // ── Anticipos (FLOW-002) ───────────────────────────────────
    //
    // Es dinero, y TODA su creacion pasa por callable dentro de una transaccion.
    // El cliente no escribe ni una: sin escritura desde aqui, un saldo a favor
    // no se puede fabricar ni retocar desde el navegador.
    //
    // No estan —y no pueden estar— en `relaxedTenantCollection`: ese match
    // generico concede escritura al `tenant_admin` de cualquier coleccion que
    // liste, que es exactamente lo contrario de lo que hace falta aqui.
    //
    // La lectura NO usa `sameTenant`: eso incluiria a la porteria, que segun la
    // PRD no ve nada de esto. Se nombran los roles que si.
    //
    // **Y el CONSEJO tampoco, desde el 24 de agosto de 2026.** Estaba nombrado
    // aqui, y eso le daba el documento ENTERO —con `unitId` y `unitLabel`—, o sea
    // **detalle financiero POR UNIDAD**: quien tiene saldo a favor y cuanto. El
    // resto del modelo se lo niega, empezando por `billingStatements`, que no
    // puede leer. Lo que la PRD §3 le concede es «el total de anticipos del
    // conjunto», un AGREGADO, y **una regla de Firestore no sabe agregar**: o
    // concede el documento entero o no concede nada.
    //
    // Se cierra, y hoy no rompe nada: `canAccessPath` deja al consejo solo en
    // `/admin/documents`, y los unicos consumidores de estas colecciones son
    // `/admin/billing` (administracion) y `/resident/account` (residente). El
    // total que la PRD le promete se construira en `PRD-V-PLAT-004`, que es donde
    // se decide que pantallas ve — hacerlo antes es fijar la forma de un dato sin
    // saber quien lo consume. Se revierte con una linea.
    match /advances/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      allow create, update, delete: if false;
    }

    // El cruce de un anticipo contra un cargo. Lleva `unitId` copiado del
    // anticipo **para que esta regla se pueda escribir**: sin el, «el residente
    // solo ve los de su unidad» no seria expresable y habria que cerrarle la
    // coleccion entera. Es denormalizacion con un motivo, no por comodidad.
    // El consejo tampoco, por lo mismo que en `advances`: el cruce lleva `unitId`
    // copiado, asi que concederlo es conceder detalle por unidad.
    match /advanceApplications/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      allow create, update, delete: if false;
    }

    // Cobros programados (F3): solo admin; el cron los publica con Admin SDK.
    match /billingSchedules/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId));
    }

    // Campañas de cobro (C1): solo admin; el cron las crea con Admin SDK.
    match /billingCampaigns/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId));
    }

    // Recordatorios programados: solo admin; el cron los envía con Admin SDK.
    match /billingReminderJobs/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId));
    }

    // ── Finanzas (módulo contable PH, F1) ──────────────────────
    // Back-office financiero: solo admin del tenant (residente no lee).
    // ─── `PRD-V-FLOW-008` · el egreso y su calendario de cuotas ───────────────
    //
    // **Un egreso CON PLAN no es lo mismo que uno sin él**, y esta regla es la que
    // lo separa. El egreso se escribe desde el cliente como siempre, pero **el
    // calendario, los pagos y las anulaciones van por callable** (`R8`), y hay
    // campos que solo el servidor escribe.
    //
    // *Este comentario decía «declarar y editar el plan sigue siendo escritura
    // directa» y dejó de ser cierto el mismo día, al cerrar `R8`.*
    //
    // ⚠️ **`installments` se guarda como `null` cuando no hay plan**, así que
    // `'installments' in d` es CIERTO para los 52 egresos de producción. Preguntarlo
    // así bloquearía el flujo de siempre; por eso se comprueba el VALOR.
    function egresoConPlan(d) {
      return d.get('installments', null) != null && d.installments.size() > 0;
    }

    // Lo que el servidor sella y el cliente no escribe nunca.
    function egresoSinSellosDelServidor(d) {
      return d.get('paidAmount', 0) == 0
        && !('voidReason' in d) && !('voidedBy' in d) && !('voidedAt' in d);
    }

    match /expenses/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);

      // **Alta**: nace sin nada de lo que sella el servidor **y SIN PLAN**. El
      // calendario se declara después, por `saveExpensePlan` — ver el bloque de
      // abajo. Un egreso nace siempre como lo que siempre fue: un importe.
      allow create: if tenantOperable(request.resource.data.tenantId)
        && signedIn() && tenantAdminOrSuper(request.resource.data.tenantId)
        && previewModuleWritable(request.resource.data.tenantId)
        && egresoSinSellosDelServidor(request.resource.data)
        && !egresoConPlan(request.resource.data);

      // **Edición**: `paidAmount` y los sellos de anulación **no se mueven desde el
      // cliente**, y **con plan el ESTADO tampoco**: lo deriva el servidor al pagar
      // o al anular. Sin plan, el estado se cambia como siempre — los 52 egresos de
      // producción no notan esta regla.
      allow update: if tenantOperable(request.resource.data.tenantId)
        && signedIn() && tenantAdminOrSuper(request.resource.data.tenantId)
        && previewModuleWritable(request.resource.data.tenantId)
        && request.resource.data.get('paidAmount', 0) == resource.data.get('paidAmount', 0)
        // **`R8` · el calendario NO se escribe desde el cliente, ni una coma.**
        // Desde la entrega 2 la deuda del conjunto se deriva de las cuotas vivas,
        // así que este array sostiene un invariante — y un campo escribible desde
        // el cliente no puede sostenerlo. Lo escribe `saveExpensePlan`, con Admin
        // SDK, que no evalúa estas reglas.
        //
        // **Esto es lo que las reglas SÍ saben hacer.** Comprobar cuota por cuota
        // que ninguna venga marcada `pagada` con un asiento inventado **no se
        // puede: el lenguaje no itera listas**. Congelar el array entero sí, y
        // cierra el mismo agujero por el otro lado.
        && request.resource.data.get('installments', null) == resource.data.get('installments', null)
        // **`affectedKeys()` y NO `changedKeys()`, y la diferencia es todo.**
        // `changedKeys()` son las claves que están en los DOS mapas con valor
        // distinto: **una clave AÑADIDA no aparece**. Con `changedKeys` esta
        // línea dejaba pasar `voidReason` en un documento que no lo tenía, que es
        // justo el caso que viene a bloquear. Medido con una sonda contra el
        // emulador, no razonado. `affectedKeys()` = añadidas + borradas + cambiadas.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['voidReason', 'voidedBy', 'voidedAt'])
        && (
          !egresoConPlan(request.resource.data)
          || request.resource.data.status == resource.data.status
        );

      // **Borrar**: un egreso con cuotas PAGADAS no se borra desde el cliente.
      // Cada cuota pagada dejó un asiento en el libro, y puede estar conciliado
      // contra una línea del banco: borrar la factura dejaría el libro hablando de
      // una cuenta por pagar que ya no existe. Lo que corresponde es anularla, que
      // conserva lo pagado (`RN-08`).
      allow delete: if tenantOperable(resource.data.tenantId)
        && signedIn() && tenantAdminOrSuper(resource.data.tenantId)
        && previewModuleWritable(resource.data.tenantId)
        && resource.data.get('paidAmount', 0) == 0;
    }

    // ✅ **`R8` CERRADO (4 sep 2026, decisión de David).**
    //
    // La primera versión de este bloque dejaba `installments` en manos del cliente
    // y anotaba la limitación: *el lenguaje de reglas no itera listas*, así que no
    // se podía comprobar cuota por cuota. Cerrar `paidAmount` dejaba la
    // manipulación **detectable, no impedida** — y eso llegó a morder de verdad,
    // aunque por la vía mundana: **el propio formulario deshacía un pago al editar
    // la descripción**, porque reenviaba el array sin lo que sella el servidor.
    //
    // **La edición del plan pasó a `saveExpensePlan`**, y entonces la regla puede
    // hacer lo que sí sabe: **congelar el array entero**. No hace falta iterar para
    // decir «esto no lo escribes tú».

    // Registro de proveedores y beneficiarios (PRD-V-FEAT-003). Mismo patrón
    // que expenses: SOLO administración lee — los datos bancarios de un
    // tercero no se muestran al residente nunca (R7), y como la regla no
    // filtra campos, se restringe la colección entera (§11.2 de la PRD).
    // Sin delete desde el cliente: un proveedor con historia no se borra, se
    // desactiva (R5/§6 — sin estado terminal). La unicidad del taxId por
    // conjunto se valida en el formulario; la regla no puede consultarla.
    match /vendors/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId));
      allow delete: if false;
    }

    // `FLOW-002` CA11 — el residente elige a que cuenta pago, asi que tiene que
    // poder LEER las cuentas del conjunto. Hasta el 24 de agosto de 2026 esto
    // era solo-administrador.
    //
    // Se abre al RESIDENTE, y SOLO las cuentas activas: una cuenta dada de
    // baja no recibe dinero nuevo, asi que nadie fuera de la administracion
    // tiene por que verla. El administrador las sigue viendo todas.
    //
    // **Al residente por su rol, NO con `tenantMember`.** Hasta el 24 de agosto
    // de 2026 esta rama decia `tenantMember`, que es cualquiera con documento en
    // `tenantUsers` — y ahi dentro esta la PORTERIA. La PRD de `FLOW-002` (§3)
    // le da al `security_guard` «Nada / no puede Acceder», y la regla de
    // `advances`, veinte lineas mas arriba, evita `sameTenant` diciendo
    // exactamente eso. Era una incoherencia dentro del mismo cambio: reproducida
    // contra el emulador, la porteria leia el documento Y podia consultar la
    // coleccion en bloque. Ninguna pantalla de `/guard` la necesita: el unico
    // consumidor de `watchActiveBankAccounts` es el portal del residente.
    // El consejo tampoco entra: la PRD no le da cuentas bancarias.
    //
    // **Lo que hizo falta para poder abrirlo:** el saldo inicial se saco de este
    // documento a `bankAccountBalances` (aqui abajo). Las reglas conceden el
    // documento ENTERO —no se pueden ocultar campos—, asi que abrir la lectura
    // con el saldo dentro le habria ensenado al residente con cuanto dinero
    // abrio cada cuenta el conjunto. El numero de cuenta si puede verlo: es a
    // donde transfiere.
    match /bankAccounts/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (tenantRole(resource.data.tenantId, 'resident') && resource.data.active == true)
      );
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId));
    }

    // El saldo inicial de cada cuenta, fuera del documento de la cuenta. El id
    // del documento es el de la cuenta. Solo la administracion: es exactamente
    // el dato que no podia quedarse arriba.
    match /bankAccountBalances/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId));
    }

    // `PRD-V-FLOW-004` R8 — **el enlace con el libro lo escribe SOLO el servidor.**
    //
    // Hasta esta ficha, el navegador escribia `reconciled` y
    // `matchedLedgerEntryId` a placer, y por eso en produccion hay una salida de
    // banco de -300.000 casada contra una entrada de +40.000. La comprobacion
    // que lo impide es aritmetica entre DOS documentos —el importe con su signo,
    // la fecha, la cuenta—, y **eso una regla no lo puede hacer**: tendria que
    // leer el asiento y comparar. Lo hace la callable `reconcileCase`; esta
    // regla solo cierra el camino viejo para que no queden los dos abiertos.
    //
    // **Importar sigue siendo escritura directa del cliente**, y esta bien: una
    // linea nace sin conciliar y no afecta a nada hasta que alguien la casa.
    // Por eso `create` se conserva, exigiendo que nazca suelta.
    //
    // Ojo con un efecto util del veto: si dos importaciones corren a la vez, la
    // segunda hace `setDoc` sobre un documento que YA existe —lo que en reglas
    // es un `update`— y si aquel ya estaba conciliado, **se deniega** en vez de
    // pisarlo con `reconciled: false`. La carrera se resuelve negando, que es lo
    // que se quiere cuando hay dinero conciliado debajo.
    match /bankStatementLines/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create: if tenantOperable(request.resource.data.tenantId)
        && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId))
        && request.resource.data.get('reconciled', false) == false
        && request.resource.data.get('matchedLedgerEntryId', null) == null;
      allow update: if tenantOperable(request.resource.data.tenantId)
        && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reconciled', 'matchedLedgerEntryId'].toSet());
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId));
    }

    // `PRD-V-FEAT-005` — las decisiones sobre el padron duplicado.
    //
    // **Identica de estrecha que `reconciliationCases`, y por la misma razon: el
    // cliente NO escribe nada.** Este documento guarda el `snapshot` de lo que se
    // piso al fusionar, que es lo unico que hace la fusion reversible; si el
    // navegador pudiera escribirlo, el snapshot valdria lo que valga el
    // navegador y «se puede deshacer» seria una frase, no una garantia. Lo
    // escriben `mergePeople` y `dismissDuplicatePeopleGroup`.
    //
    // Y la advertencia que este repositorio ya pago: **una regla no protege lo
    // que escribe una callable** (Admin SDK no las evalua). Esto cierra el
    // camino del cliente; el invariante vive en `padron.ts`.
    //
    // La lectura es solo de la administracion: el snapshot lleva documentos
    // enteros de personas —documento de identidad, correo, telefono—, asi que el
    // residente, la porteria y el consejo no entran.
    match /personMergeDecisions/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // `PRD-V-FLOW-004` — el expediente de una linea de extracto.
    //
    // **Mas estrecha que `bankStatementLines` a proposito: el cliente NO escribe
    // nada.** El caso es el registro de que se decidio y por que; si el
    // navegador pudiera escribirlo, el motivo de un descarte valdria lo que
    // valga el navegador. Lo escriben las callables del expediente y el reverso.
    //
    // La lectura es solo de la administracion. Las descripciones del extracto
    // nombran unidades y a veces personas, asi que el residente, la porteria y
    // el consejo no entran — la misma frontera que `bankAccountBalances`.
    match /reconciliationCases/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // Plan de cuentas gobernado (PRD-V-PLAT-003).
    //
    // El id del documento es DERIVADO del codigo: `{tenantId}_{code}`. Eso es
    // lo que hace que la unicidad del codigo por conjunto la garantice la BASE
    // y no una comprobacion previa del cliente, que dos pestanas abiertas ganan
    // a la vez. Por eso la regla EXIGE que el id coincida: si no lo exigiera, se
    // podria escribir un documento con `code: "1.1"` bajo cualquier otro id y la
    // unicidad quedaria en nada.
    //
    // R3 y R4 se apoyan en lo mismo: una cuenta de sistema (`systemKey`) no se
    // borra, y **cambiar el codigo es imposible por construccion** —seria otro
    // documento—, asi que R4 no necesita una clausula propia: lo que hay que
    // vetar es que el update MUEVA el codigo dentro del mismo documento.
    //
    // Lo que estas reglas NO pueden comprobar es «tiene movimientos», porque
    // eso exige consultar `ledgerEntries`. Esa parte (R5) vive en la UI y, para
    // el borrado, en que una cuenta con `systemKey` no se borra nunca.
    match /chartOfAccounts/{docId} {
      // `resource == null` cuando el documento NO existe, que es el caso de la
      // transaccion que crea una cuenta: lee primero para negarse si el codigo
      // ya esta. Sin esta rama, `resource.data.tenantId` sobre un documento
      // inexistente hace fallar la evaluacion y el `get` de la transaccion se
      // deniega — y el formulario responde «No tienes permiso para realizar
      // esta accion», que no se parece en nada a lo que pasa. La misma rama
      // esta en `financialCounters` y en `survey_responses`, por lo mismo.
      allow read: if signedIn() && (resource == null || sameTenant(resource.data.tenantId));

      // El RANGO RESERVADO, y va en la regla y no solo en el formulario a
      // proposito: la siembra escribe con el SDK de admin, que no pasa por
      // aqui, asi que esta linea solo restringe lo que crea un administrador.
      //
      // `N.50` en adelante. Por debajo se lo reserva la semilla, porque la
      // siembra no pisa lo que existe: si un conjunto ya uso la 1.9 y manana la
      // semilla reclama esa 1.9, el sembrador la salta EN SILENCIO y ese
      // conjunto se queda con un codigo que significa otra cosa que en los
      // demas — y el consolidado entre conjuntos suma mal.
      //
      // Segundo nivel obligatorio: el primer nivel es la estructura del libro
      // —Ingresos y Egresos— y una tercera raiz no seria ni una cosa ni otra.
      allow create: if tenantOperable(request.resource.data.tenantId)
        && signedIn() && tenantAdminOrSuper(request.resource.data.tenantId)
        && previewModuleWritable(request.resource.data.tenantId)
        && docId == request.resource.data.tenantId + '_' + request.resource.data.code
        && request.resource.data.code.matches('^[1-9][0-9]{0,2}\\.([5-9][0-9]|[1-9][0-9]{2})$');

      // El codigo y el conjunto son inmutables; el nombre y el estado, no.
      allow update: if tenantOperable(request.resource.data.tenantId)
        && signedIn() && tenantAdminOrSuper(request.resource.data.tenantId)
        && previewModuleWritable(request.resource.data.tenantId)
        && docId == request.resource.data.tenantId + '_' + request.resource.data.code
        && request.resource.data.code == resource.data.code
        && request.resource.data.tenantId == resource.data.tenantId;

      // R3: las cuentas sembradas no se borran. Se desactivan.
      allow delete: if tenantOperable(resource.data.tenantId)
        && signedIn() && tenantAdminOrSuper(resource.data.tenantId)
        && previewModuleWritable(resource.data.tenantId)
        && !('systemKey' in resource.data);
    }

    match /ledgerEntries/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      // FIN-001: los asientos que nacen de un pago los escribe SOLO el servidor,
      // dentro de la transaccion que tambien mueve la cuota. Si el cliente
      // pudiera crearlos, podria registrar un ingreso en el libro sin que la
      // cartera se enterase — que es exactamente la incoherencia que la ficha
      // cierra. Los movimientos manuales (egresos, ajustes, reversos) siguen
      // escribiendose desde la consola: esta regla solo veta los de origen pago.
      //
      // FLOW-002: `advance` entra en el mismo veto. El asiento de entrada de un
      // anticipo nace dentro de la transaccion de `aplicarPago`, igual que el
      // del cobro, y cuenta como ingreso del periodo (R5). Si el cliente pudiera
      // crearlo, podria inflar el ingreso del conjunto inventandose un anticipo
      // que nadie pago. Va aqui y no solo en la coleccion `advances` porque son
      // dos escrituras distintas: vetar una y dejar la otra abierta deja el
      // libro cuadrando con un dinero que no existe.
      //
      // **El veto miraba SOLO el documento entrante, y eso dejaba dos huecos que
      // se descubrieron probandolos contra el emulador el 24 de agosto de 2026.**
      //
      // 1. **Sobrescritura completa.** Un `setDoc` sin `merge` sobre el asiento de
      //    un anticipo, omitiendo `sourceType`, pasaba el veto: `request.resource`
      //    no lo traia, asi que no estaba en la lista. Se podia pisar el importe y
      //    borrar el origen del asiento que sostiene un saldo a favor.
      // 2. **Y al reves, se bloqueaba lo legitimo.** En un `update` con merge
      //    Firestore evalua el documento RESULTANTE, que si conserva el
      //    `sourceType`, asi que marcar conciliado un asiento de pago se
      //    denegaba. Como desde `FIN-001` **todos** los asientos de cobro nacen
      //    con `sourceType: 'billingStatement'`, la conciliacion no podia casar
      //    ni un pago: justo lo que esa pantalla existe para hacer.
      //
      // La regla mira ahora el documento QUE YA ESTA. Si es de origen pago, lo
      // unico que se le puede tocar es la conciliacion; si no lo es, sigue sin
      // poder convertirse en uno. No cuesta ningun `get()` extra: `resource` ya
      // esta cargado.
      // **`PRD-V-FLOW-004` R8, y esto ENSANCHA el veto en un sentido que importa.**
      // Los tres campos de la conciliacion salen de lo que el cliente puede
      // tocar **en cualquier asiento**, no solo en los de origen pago. El
      // emparejamiento falso que motiva la ficha se escribio sobre un asiento
      // `manual`, que era justo el que esta lista no cubria: para el, la rama de
      // abajo lo permitia todo.
      //
      // Y una consecuencia buscada: para un asiento de cobro, la lista de lo
      // tocable se queda en `updatedBy`/`updatedAt`, o sea **nada util**. Es lo
      // correcto — lo unico que el cliente podia hacerle era conciliarlo, y eso
      // ahora pasa por la callable.
      allow create: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId))
        && !(request.resource.data.get('sourceType', '') in ['billingStatement', 'advance'])
        && request.resource.data.get('reconciled', false) == false
        && request.resource.data.get('bankStatementLineId', null) == null;
      allow update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId) && previewModuleWritable(request.resource.data.tenantId))
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['reconciled', 'bankStatementLineId', 'reconciledAt'].toSet())
        && (resource.data.get('sourceType', '') in ['billingStatement', 'advance']
              ? request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['updatedBy', 'updatedAt'])
              : !(request.resource.data.get('sourceType', '') in ['billingStatement', 'advance']));
      // Borrar tampoco: un asiento de cobro o de anticipo se anula con su
      // reverso, que lo escribe el servidor. Borrarlo desde el navegador quitaria
      // el ingreso del libro dejando viva la cuota o el saldo a favor que lo
      // justifica, y sin rastro de que existio.
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId) && previewModuleWritable(resource.data.tenantId))
        && !(resource.data.get('sourceType', '') in ['billingStatement', 'advance']);
    }

    // Secuencial de comprobantes: se lee/escribe dentro de una transacción.
    // El read permite documento inexistente (resource == null) para que la
    // transacción pueda inicializar el contador.
    match /financialCounters/{docId} {
      allow read: if signedIn() && (resource == null || tenantAdminOrSuper(resource.data.tenantId));
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && superadmin());
    }

    // Comprobantes/recibos: admin todos; residente solo los suyos (por unidad).
    // El recibo lo emite y lo anula el SERVIDOR, dentro de la transaccion del
    // pago (`functions/src/payments.ts`, 20 ago 2026). El cliente solo lee.
    //
    // Antes podia crearlo y actualizarlo, porque lo construia el navegador
    // despues de aplicar el pago. Al mover la emision al servidor esa concesion
    // dejo de hacer falta, y dejarla abierta permitiria fabricar un recibo de un
    // pago que no existe — el reverso exacto del hueco que esto cierra.
    //
    // OJO AL DESPLEGAR: esta regla RESTRINGE, asi que va DESPUES del front que
    // dejo de escribir. Al reves rompe el cobro manual hasta que termine el
    // rollout. Es la leccion de FIN-001.
    match /paymentVouchers/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.payerUnitId)
      );
      allow create, update: if false;
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    // Repositorio documental del conjunto. **Una sola coleccion con contenido
    // mezclado**: el reglamento y las actas conviven con lo que archiva
    // `monthlyFinancialArchive`, y eso lleva DETALLE POR UNIDAD —la hoja
    // «Morosos» del historico de cartera dice que unidad debe y cuanto, y el
    // reporte de comite trae «mayores deudores»—. De 39 documentos en
    // produccion, 32 son de esos dos tipos.
    //
    // **Hasta el 24 de agosto de 2026 esto era `sameTenant`**, o sea CUALQUIER
    // miembro: el residente y tambien la PORTERIA. Y no era teorico: el
    // documento guarda un `fileUrl` con `firebaseStorageDownloadTokens`, y un
    // enlace con token **se salta las reglas de Storage**, asi que la carpeta
    // financiera estando cerrada en `storage.rules` no protegia nada mientras
    // se pudiera leer el documento. Es el mismo animal que `bankAccounts` esa
    // misma manana.
    //
    // Se nombran los roles, como en `advances` y `bankAccounts`:
    // - **Administracion y superadmin:** todo.
    // - **Consejo:** todo, y no es una concesion nueva. `canAccessPath` le deja
    //   SOLO en `/admin/documents`, esa pantalla consulta sin filtrar por
    //   categoria, y los reportes de comite son precisamente suyos. Cerrarle por
    //   categoria le rechazaria la consulta entera y lo dejaria sin su unica
    //   pantalla.
    // - **Residente:** solo las categorias compartibles. Es LISTA BLANCA: con
    //   lista negra, una categoria nueva se publicaria sola.
    // - **Porteria:** nada. Ninguna pantalla de `/guard` lee esta coleccion.
    //
    // **La consulta del residente TIENE que filtrar por `category`**, o Firestore
    // la rechaza entera aunque todos los documentos fueran compartibles: evalua
    // la consulta contra la regla **sin ejecutarla**. Lo hace
    // `features/documents/use-documents.ts` con un `where in` sobre esta misma
    // lista. Si las dos se separan, la pantalla deja de cargar.
    match /documents/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        tenantRole(resource.data.tenantId, 'committee') ||
        (tenantRole(resource.data.tenantId, 'resident') &&
          resource.data.get('category', '') in ['asamblea', 'comunicado', 'acuerdo', 'reglamento', 'plano', 'memoria', 'otro'])
      );
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    // Carpetas del repositorio documental (sistema tipo Drive). Solo admin del
    // tenant. Se crean/renombran/borran vía Cloud Functions (integridad de
    // path/depth y cascada) — el cliente solo lee.
    match /documentFolders/{docId} {
      allow read: if signedIn() && resource.data.tenantId is string && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (false);
      allow delete: if tenantOperable(resource.data.tenantId) && (false);
    }

    match /amenities/{docId} {
      allow read: if signedIn() && resource.data.tenantId is string && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          securityGuardRole(resource.data.tenantId) &&
          resource.data.status == 'active' &&
          (!('isReservable' in resource.data) || resource.data.isReservable == true) &&
          (!('deletedAt' in resource.data) || resource.data.deletedAt == null)
        ) ||
        (
          tenantRole(resource.data.tenantId, 'resident') &&
          resource.data.status == 'active' &&
          (!('isReservable' in resource.data) || resource.data.isReservable == true) &&
          (!('deletedAt' in resource.data) || resource.data.deletedAt == null)
        )
      );
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    match /tickets/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      allow create: if tenantOperable(request.resource.data.tenantId) && (signedIn() && (
        tenantAdminOrSuper(request.resource.data.tenantId) ||
        (
          residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
          request.resource.data.createdBy == request.auth.uid
        )
      ));

      // Resident can update only own ticket, admin/superadmin can manage all tenant tickets.
      allow update: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          residentOwnUnit(resource.data.tenantId, resource.data.unitId) &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.unitId == resource.data.unitId
        )
      ));
    }

    // ── Soporte al cliente (PRD-V-FEAT-001) ──────────────────────────────────
    // El administrador del conjunto LEE los suyos; escribir es siempre por
    // callable. Cuatro razones para no dejar escritura directa: manda correo,
    // hay campos que el cliente no debe poder falsificar (status, priority,
    // createdBy), el hilo es append-only, y hay límites por conjunto que
    // exigen contar antes de escribir.
    //
    // OJO: `supportTickets` está EXCLUIDO a propósito de tenantOperable(). Un
    // conjunto suspendido o vencido tiene que poder abrir un ticket: es el
    // canal por el que deja de estarlo. Es la única excepción del sistema.
    match /supportTickets/{docId} {
      allow read: if signedIn() && (
        superadmin() ||
        (resource.data.tenantId is string && tenantRole(resource.data.tenantId, 'tenant_admin'))
      );
      // Sin escritura desde el cliente, en ningún rol. Solo el Admin SDK.
      allow create, update: if false;
      // Un ticket cerrado es historial de la relación comercial: no se borra.
      allow delete: if false;

      // Notas internas del equipo. Viven en subcolección y no en el documento
      // porque las reglas de Firestore NO filtran campos: en el mismo doc, el
      // administrador con permiso de lectura las recibiría enteras por mucho
      // que la interfaz no las pinte. Ocultar no es proteger.
      match /internal/{noteId} {
        allow read: if superadmin();
        allow write: if false;  // solo el Admin SDK
      }
    }

    match /reservations/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        securityGuardRole(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      // **`PRD-V-FIX-001` paso 4 — la rama del RESIDENTE se retiro el 24 de
      // agosto de 2026, y es el unico paso de la ficha SIN VUELTA ATRAS con
      // bandera.**
      //
      // Un residente ya no crea reservas desde el cliente: pasa por
      // `createReservationRequest`. El motivo no es de exposicion de datos sino
      // de regla de negocio — **la regla validaba quien y donde, no cuanto,
      // cuando ni si debe**. Seis de las trece reglas exigen CONTAR reservas
      // (cupo mensual, aforo por turno, solapamiento) y una regla de Firestore
      // no cuenta; la compuerta de morosos vivia solo en el navegador, asi que
      // un moroso podia reservar el salon social escribiendo directo, que es
      // exactamente lo que la funcionalidad existia para impedir.
      //
      // **El administrador CONSERVA su rama**, a proposito: reserva a nombre de
      // cualquier unidad y no pasa por la compuerta.
      //
      // Las validaciones que estaban aqui no se han perdido — se replican en la
      // callable (`functions/src/reservations.ts`), porque siguen siendo ciertas
      // y son baratas.
      //
      // **Se cerro con la puerta de §13 medida, no supuesta:**
      // `scripts/verificar-reservas-por-servidor.mjs` sobre produccion daba
      // `1 servidor · 0 admin · 0 residente` — y ese 1 se genero a proposito
      // reservando desde el portal del residente, porque **una puerta que se
      // abre sobre un conjunto VACIO no verifica nada**: con cero clientes
      // reales, «ningun residente escribio directo» se cumple solo.
      //
      // Rollback: volver a desplegar las reglas anteriores. No hay interruptor.
      allow create: if tenantOperable(request.resource.data.tenantId) && (
        signedIn() && tenantAdminOrSuper(request.resource.data.tenantId)
      );

      // Tenant admins and superadmin can fully manage reservations.
      allow update: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          residentOwnUnit(resource.data.tenantId, resource.data.unitId) &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.unitId == resource.data.unitId &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.amenityId == resource.data.amenityId &&
          request.resource.data.amenity == resource.data.amenity &&
          request.resource.data.date == resource.data.date &&
          request.resource.data.startTime == resource.data.startTime &&
          request.resource.data.endTime == resource.data.endTime &&
          request.resource.data.slot == resource.data.slot &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.updatedBy == request.auth.uid
        )
      ) && (
        request.resource == null ||
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['date', 'startTime']) ||
        isDateTimeAtOrAfterBuffer(request.resource.data.date, request.resource.data.startTime, 30)
      ));

      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && tenantAdminOrSuper(resource.data.tenantId));
    }

    match /services/{docId} {
      // Admins manage all services for their tenant.
      // Residents can only read active services.
      allow read: if signedIn() && resource.data.tenantId is string && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (tenantRole(resource.data.tenantId, 'resident') && resource.data.status == 'active')
      );
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    match /packages/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        securityGuardRole(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      allow create: if tenantOperable(request.resource.data.tenantId) && (signedIn() && (
        tenantAdminOrSuper(request.resource.data.tenantId) ||
        (
          securityGuardRole(request.resource.data.tenantId) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.registeredBy == request.auth.uid
        )
      ));

      // Resident can only acknowledge receipt by setting delivered status.
      allow update: if tenantOperable(resource.data.tenantId) && (signedIn() && sameTenant(resource.data.tenantId) && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          securityGuardRole(resource.data.tenantId) &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.status == 'delivered' &&
          resource.data.status == 'pending' &&
          request.resource.data.updatedBy == request.auth.uid
        ) ||
        (
          residentOwnUnit(resource.data.tenantId, resource.data.unitId) &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.unitId == resource.data.unitId &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'delivered' &&
          request.resource.data.receivedBy == request.auth.uid
        )
      ));
    }

    match /auditLogs/{docId} {
      allow read: if superadmin();
      allow write: if false; // Audit logs must be written via Cloud Functions.
    }

    // Telemetría de uso y costo de IA (Paso 1.5 del programa de IA).
    // Solo la escribe el servidor, igual que auditLogs: una fila que pudiera
    // escribir el cliente no serviría para medir nada — ni el gasto ni la tasa
    // de fallo, que es la métrica que dice si la capacidad sirve.
    // Contiene metadatos y NUNCA contenido del conjunto (regla del Paso 0).
    match /aiUsage/{docId} {
      allow read: if superadmin();
      allow write: if false;
    }

    // Feedback del borrador asistido (Paso 2.5): qué hizo la persona con lo que
    // se le propuso. Lo escribe SOLO el servidor, aunque el dato nazca en el
    // navegador — si el cliente pudiera escribir aquí, cualquiera podría
    // fabricar la evidencia con la que se decide si la funcionalidad sigue.
    match /aiFeedback/{docId} {
      allow read: if superadmin();
      allow write: if false;
    }

    // Modo sombra de PQRS (Fase 4 de PRD-VAI-FEAT-002): la sugerencia del
    // modelo para cada ticket y, al lado, lo que decidió el administrador. Un
    // documento por ticket, con el ticketId de identificador.
    //
    // `write: false` es lo de siempre —solo el servidor escribe—, pero el
    // `read` es lo que hace que la sombra sea sombra, y por eso esta colección
    // existe en vez de un campo dentro del ticket: la regla de `tickets` deja
    // leer a su RESIDENTE, así que un campo ahí dentro sería visible para quien
    // escribió el ticket. Aquí no lo ve nadie del conjunto — ni el residente,
    // ni el administrador, ni el comité.
    //
    // A diferencia de aiUsage y aiFeedback, esta colección SÍ guarda contenido
    // del conjunto (el resumen y el borrador propuestos). No es una excepción a
    // la regla del Paso 0 sino su límite: aquel prohíbe contenido en las
    // colecciones de telemetría agregada, y esto es el conjunto de evaluación
    // que G7 mide ticket a ticket. Quien lo lee ya puede leer el ticket entero.
    match /aiAssistance/{docId} {
      allow read: if superadmin();
      allow write: if false;
    }

    // Telemetría de la importación tabular (PRD-V-FEAT-002, CA-13): cuántos
    // intentos empiezan y cuántos terminan. Mismo criterio que aiFeedback y por
    // el mismo motivo: es la evidencia con la que se decidirá si el paso de
    // mapeo sirvió, y una evidencia que el cliente puede escribir no es
    // evidencia. La escribe la callable `registrarImportacion`.
    match /importRuns/{docId} {
      allow read: if superadmin();
      allow write: if false;
    }

    // Contadores de cuota de IA (Paso 1.6). Los escribe solo el servidor, y en
    // transacción: un contador que el cliente pudiera tocar no es una cuota.
    // Lo que un conjunto necesita saber —cuánto le queda— se lo devuelve la
    // puerta en la respuesta, no leyendo esto.
    match /aiQuotaCounters/{docId} {
      allow read: if superadmin();
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if superadmin();
    }

    // ─── Certificados de paz y salvo (PRD-V-FEAT-004 §11.2) ──────────────────
    //
    // **Lectura para tres, escritura para NADIE desde el cliente.** Las escriben
    // dos callables con Admin SDK, que no evalúa estas reglas — así que dejarlas
    // abiertas al administrador sería una segunda puerta al mismo sitio, y la
    // lección de `CF8` es que las dos se olvidan por separado.
    //
    // **Y aquí importa más que en otros sitios:** la única condición de este
    // documento es «saldo cero». Si el cliente pudiera crearlo, cualquiera se
    // emitiría un paz y salvo debiendo — un papel que se enseña en una notaría.
    //
    // R9 · el residente alcanza los de SU unidad, con el mismo `residentOwnUnit`
    // que ya gobierna sus cargos. El consejo lee los del conjunto: el
    // certificado no dice nada personal, solo si una unidad debe.
    // `PRD-V-FLOW-003` §11.2 — el rastro de entrega de cada correo.
    //
    // **Solo administración y superadmin, y el consejo NO** — a diferencia de
    // `clearanceCertificates`, aquí abajo, que sí se lo concede. La diferencia es
    // deliberada: esta colección guarda la DIRECCIÓN DE CORREO de cada residente y
    // qué se le mandó, que es detalle personal. Al consejo le corresponde el
    // agregado, no el renglón. Es la misma línea que se trazó el 24 de agosto al
    // retirarle la lectura de `advances`.
    //
    // Escritura cerrada entera: la fila nace en `sendNotificationEmail` y la mueve
    // el webhook, los dos con Admin SDK. Nada del cliente escribe aquí — y **eso no
    // lo sostiene esta regla sino que nadie más escriba**, porque una callable con
    // Admin SDK no evalúa `firestore.rules`.
    match /emailDeliveries/{docId} {
      allow read: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // ─── `PRD-V-FLOW-007` · el informe económico mensual ──────────────────────
    //
    // **ESCRITURA CERRADA AL CLIENTE, entera.** Las cuatro operaciones —regenerar,
    // emitir, firmar y anular— van por callable con Admin SDK, que **no evalúa
    // estas reglas**. Dejar aquí una rama de administrador sería una segunda
    // puerta al mismo sitio, y la lección de `CF8` es que las dos puertas se
    // olvidan por separado. Con `create, update, delete: if false`:
    //
    //   · `CA6`  — un `update` sobre un informe `emitido` que toque una cifra
    //     queda rechazado **por la regla**, no escondido en la interfaz. Y no
    //     solo sobre `emitido`: sobre cualquier estado.
    //   · `CA16` — anular sin motivo lo rechaza el SERVIDOR (`anularInforme`),
    //     porque por aquí no se puede anular en absoluto.
    //   · `CA14` — un conjunto `suspended` no emite: la callable lo veta con
    //     `assertTenantOperable`, espejo de `tenantOperable` de aquí.
    //
    // **LECTURA.** El administrador ve todos los estados, incluidos los
    // borradores. El consejo ve **solo lo que ya se emitió**: un borrador tiene
    // cifras que todavía cambian, y enseñárselo invita a discutir números que
    // nadie ha afirmado. `CA15` — el `anulado` **sí** se lee, marcado: archivar
    // no es esconder.
    //
    // **EL RESIDENTE NO LEE NADA AQUÍ, todavía.** Es la entrega 3, y su alcance
    // **espera al abogado** (`RN-11`, y el `TBD-L` heredado de `FLOW-006`). Abrirlo
    // ahora sería publicar el detalle por unidad de la cartera —quién debe y
    // cuánto— a la comunidad entera: `CA10`, `CA11` y `CA12` deben FALLAR hoy, y
    // fallan porque no hay rama de residente. Cerrarlo después de que la
    // comunidad lo vio no se puede.
    //
    // ✅ **Estas ramas SÍ están ejercitadas contra el emulador**, en
    // `tests/informe-mensual.rules.test.ts` (17 casos). Y con la falsación que
    // importa: **borrar este bloque entero dejó las trece pruebas de escritura en
    // VERDE** —las satisface el deny por defecto— y solo enrojecieron las cuatro
    // de lectura. Una prueba de denegación no prueba que exista una regla.
    match /monthlyReports/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (tenantRole(resource.data.tenantId, 'committee') && resource.data.status != 'borrador')
      );
      allow create, update, delete: if false;
    }

    match /clearanceCertificates/{docId} {
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        tenantRole(resource.data.tenantId, 'committee') ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      allow create, update, delete: if false;
    }

    // ─── Empresas administradoras (PRD-V-PLAT-002 §7.1) ───────────────────────
    //
    // **Bloque explícito, y no cae en `relaxedTenantCollection`**: esta colección
    // NO lleva `tenantId` porque vive por encima del conjunto, así que ninguna
    // de las reglas de conjunto la sabría proteger.
    //
    // **Lectura solo superadmin, y es MÁS estricto de lo que pedía la ficha.**
    // §7.1 decía «lectura para los miembros de un conjunto asociado», y eso no
    // se puede expresar aquí: haría falta preguntar «¿existe un conjunto con
    // esta administradora donde yo sea miembro?», y las reglas no iteran. La
    // salida cómoda era `signedIn()`, que expone `taxId`, correo y teléfono de
    // la empresa a cualquier residente de cualquier conjunto. En su lugar el
    // NOMBRE se desnormaliza en `tenants` —que los miembros ya leen— y el
    // registro se cierra.
    //
    // **Escritura cerrada al cliente**, no «solo superadmin»: la hacen dos
    // callables con Admin SDK, que NO evalúa estas reglas. Dejarla abierta al
    // superadmin sería una segunda puerta al mismo sitio, y la lección de `CF8`
    // es justamente que las dos puertas se olvidan por separado.
    match /managementCompanies/{companyId} {
      allow read: if superadmin();
      allow create, update, delete: if false;
    }

    // ─── Banderas de funcionalidad y kill switch (Paso 1.1 del programa de IA) ─
    //
    // Dos colecciones, y la separación es de seguridad, no de estilo:
    //
    //  · featureFlags/{flagKey} → default global + kill switch de esa bandera.
    //    Lo lee cualquier sesión porque NO contiene ningún dato de conjunto.
    //  · featureFlags/_global   → kill switch maestro: apaga todas de golpe.
    //  · featureFlagOverrides/{tenantId} → `{ flags: { clave: bool } }`.
    //    Lo lee solo ese conjunto. Si los overrides vivieran dentro del
    //    documento de la bandera, cualquier residente firmado podría enumerar
    //    los conjuntos de la plataforma leyendo el mapa.
    //
    // Escribe solo superadmin. Los tipos se validan aquí para que un valor mal
    // puesto se rechace en el momento y no se descubra el día que hay que
    // apagar algo: el lector ignora lo que no sea booleano estricto.
    // Espejo del lector: src/lib/feature-flags/ y functions/src/feature-flags.ts.
    match /featureFlags/{flagId} {
      allow read: if signedIn();
      allow create, update: if superadmin() &&
        (!('enabled' in request.resource.data) || request.resource.data.enabled is bool) &&
        (!('killSwitch' in request.resource.data) || request.resource.data.killSwitch is bool);
      allow delete: if superadmin();
    }

    match /featureFlagOverrides/{tenantId} {
      allow read: if superadmin() || tenantMember(tenantId);
      allow create, update: if superadmin() &&
        (!('flags' in request.resource.data) || request.resource.data.flags is map);
      allow delete: if superadmin();
    }

    // Solicitudes de cambio de unidad
    match /unitChangeRequests/{docId} {
      allow read: if signedIn() && (
        // El propio residente puede leer su solicitud
        resource.data.userId == request.auth.uid || 
        // Admin del tenant o superadmin pueden leer
        tenantAdminOrSuper(resource.data.tenantId)
      );
      allow create: if signedIn() && (
        // Solo el propio residente puede crear su solicitud, y solo para su tenant
        request.resource.data.userId == request.auth.uid &&
        tenantRole(request.resource.data.tenantId, 'resident') &&
        request.resource.data.tenantId == membershipDoc(request.resource.data.tenantId).data.tenantId
      );
      allow update: if signedIn() && (
        // Solo admin del tenant o superadmin pueden aprobar/rechazar
        tenantAdminOrSuper(resource.data.tenantId)
      );
      allow delete: if false;
    }

    // ─── Encuestas de comunidad (ENQ-01) ────────────────────────────────────

    match /surveys/{docId} {
      // Admins and residents of the same tenant can read surveys
      allow read: if signedIn() && (
        resource.data.tenantId is string && (
          tenantAdminOrSuper(resource.data.tenantId) ||
          tenantRole(resource.data.tenantId, 'resident')
        )
      );
      // Only tenant admins and superadmins can create surveys or do full updates
      allow create: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId));
      // Admins can update any field; residents can only touch responseCount
      // Note: FieldValue.increment() is a server sentinel — arithmetic comparison in rules
      // is not possible. hasOnly(['responseCount']) is a sufficient guard.
      allow update: if tenantOperable(resource.data.tenantId) && (signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        (
          tenantRole(resource.data.tenantId, 'resident') &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['responseCount'])
        )
      ));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    match /survey_responses/{docId} {
      // Admins see all responses; residents can only read their own.
      // resource == null when doc doesn't exist (transaction.get on missing doc).
      allow read: if signedIn() && (
        resource == null ||
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      // Residents can create their own response only (write-once — update and delete are denied)
      allow create: if signedIn() &&
        residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
        request.resource.data.tenantId is string &&
        request.resource.data.unitId is string &&
        request.resource.data.unitId == membershipDoc(request.resource.data.tenantId).data.unitId;
      allow update, delete: if false;
    }
    // ─── Comprobantes de pago (residente sube, admin revisa) ─────────────────

    match /paymentReceipts/{docId} {
      // Admins see all receipts for their tenant; residents see only their own.
      allow read: if signedIn() && (
        tenantAdminOrSuper(resource.data.tenantId) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      // Residents can upload their own receipt only.
      allow create: if signedIn() &&
        residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
        request.resource.data.uploadedBy == request.auth.uid &&
        request.resource.data.unitId == membershipDoc(request.resource.data.tenantId).data.unitId;
      // Only admins can update status (approve/reject); residents cannot edit.
      allow update: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
      allow delete: if signedIn() && tenantAdminOrSuper(resource.data.tenantId);
    }
    // ─── Firmas de reglamento (REG-01) ───────────────────────────────────────

    match /regulation_signatures/{docId} {
      // Admins and superadmins can read all signatures for their tenant.
      // Residents can only read their own unit's signature.
      allow read: if signedIn() && (
        resource == null ||
        (resource.data.tenantId is string && tenantAdminOrSuper(resource.data.tenantId)) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      // Residents can create their own signature only (write-once — update and delete are denied)
      allow create: if signedIn() &&
        residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
        request.resource.data.tenantId is string &&
        request.resource.data.unitId is string &&
        request.resource.data.signedBy == request.auth.uid &&
        request.resource.data.unitId == membershipDoc(request.resource.data.tenantId).data.unitId;
      allow update, delete: if false;
    }

    match /committee_agreements/{docId} {
      allow read: if signedIn() && sameTenant(resource.data.tenantId);
      allow create, update: if tenantOperable(request.resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(request.resource.data.tenantId));
      allow delete: if tenantOperable(resource.data.tenantId) && (signedIn() && tenantAdminOrSuper(resource.data.tenantId));
    }

    match /committee_agreement_signatures/{docId} {
      // Admins/superadmins leen todas las firmas del tenant; el residente solo la de su unidad.
      allow read: if signedIn() && (
        resource == null ||
        (resource.data.tenantId is string && tenantAdminOrSuper(resource.data.tenantId)) ||
        residentOwnUnit(resource.data.tenantId, resource.data.unitId)
      );
      // El residente crea solo la firma de su unidad (write-once; update/delete denegados).
      allow create: if signedIn() &&
        residentOwnUnit(request.resource.data.tenantId, request.resource.data.unitId) &&
        request.resource.data.tenantId is string &&
        request.resource.data.unitId is string &&
        request.resource.data.signedBy == request.auth.uid &&
        request.resource.data.unitId == membershipDoc(request.resource.data.tenantId).data.unitId;
      allow update, delete: if false;
    }

    // G4 · Observabilidad: errores del cliente. Solo el superadmin los lee; la
    // escritura la hace exclusivamente la Cloud Function (admin SDK, salta reglas).
    match /errorLogs/{docId} {
      allow read: if superadmin();
      allow write: if false;
    }

    // Invitaciones de onboarding (Opción B). El token es secreto y solo se valida
    // por Cloud Functions (admin SDK). Ningún cliente lee ni escribe directamente.
    match /accountInvites/{token} {
      allow read, write: if false;
    }

    // Leads de marketing (formularios del landing y, más adelante, altas de trial).
    // Contienen datos de contacto de prospectos: solo el superadmin los lee. La
    // escritura la hacen las rutas de servidor con admin SDK, que salta reglas.
    match /leads/{leadId} {
      allow read: if superadmin();
      // Crear y borrar siguen vetados: los leads los escribe el servidor (los
      // formularios del landing pasan por la API con Admin SDK). El UPDATE de
      // superadmin es REVOPS-001E: asignar dueño y referencia de CRM desde la
      // bandeja. Antes decia `write: if false` a secas, y markTrialAsLost
      // llevaba desde entonces intentando marcar el lead como perdido desde el
      // cliente — con el rechazo tragado por un catch vacio.
      allow update: if superadmin();
      allow create, delete: if false;
    }

    // Catalogo de comerciales (REVOPS-001E). Coleccion GLOBAL, fuera de los
    // conjuntos: un KAM no es un rol de tenant y no tiene cuenta en el
    // producto — es un registro de quien vende, para atribuir leads y
    // conjuntos. Solo la consola Superadmin lo ve y lo edita.
    match /salesReps/{repId} {
      allow read, write: if superadmin();
    }
  }
}
